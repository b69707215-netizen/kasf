{
  "name": "kasf",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy", "/alerts", "/ua-alerts", "/bot-status", "/tg", "/tg/*", "/link", "/link/*"]
  },
  // Telegram-бот: щохвилини запуск, усередині — перевірки кожні 3 с до ~52-ї секунди (цілі, тривоги з кількох джерел, балістика)
  "triggers": { "crons": ["* * * * *"] },
  // сховище стану бота (хто вже був у радіусі); wrangler створює його автоматично при деплої
  // адреса Worker для автопідключення webhook (самолікування)
  "vars": { "WORKER_URL": "https://damih-havajsa.pp.ua" },
  "kv_namespaces": [{ "binding": "STATE" }],
  // стан бота (що вже оголошено) — у Durable Object: безкоштовні 100 000 записів/добу замість 1000 у KV
  "durable_objects": { "bindings": [{ "name": "BOT_STATE", "class_name": "BotState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }]
}
