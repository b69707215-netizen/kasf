{
  "name": "kasf",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy", "/alerts", "/tg", "/tg/*", "/link", "/link/*"]
  },
  // Telegram-бот: щохвилини запуск, у ньому 12 перевірок з паузою 5 с (радіус 20 км від Павлограда)
  "triggers": { "crons": ["* * * * *"] },
  // сховище стану бота (хто вже був у радіусі); wrangler створює його автоматично при деплої
  "kv_namespaces": [{ "binding": "STATE" }]
}
